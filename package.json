{
  "name": "marketing-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Pages marketing operations dashboard.",
  "scripts": {
    "dev": "wrangler pages dev public --d1 DB=marketing_dashboard",
    "deploy": "wrangler pages deploy public",
    "db:migrate:local": "wrangler d1 migrations apply marketing_dashboard --local",
    "db:migrate:remote": "wrangler d1 migrations apply marketing_dashboard --remote",
    "smoke": "node ./scripts/smoke-test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.18.0"
  }
}
